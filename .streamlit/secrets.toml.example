# Copy this file to .streamlit/secrets.toml (on your PC)
# or paste the same line into Streamlit Cloud → App → Settings → Secrets.
#
# Free key, no card needed: https://aistudio.google.com/apikey  → "Create API key"
# Several keys separated by commas are used in turn (more free notes per day).
GEMINI_API_KEY = "AIza...your-key..."

# Optional: force a model (others are still used if it is busy)
# NOTES_MODEL = "gemini-2.5-flash"
